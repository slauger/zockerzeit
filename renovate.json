{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "platformAutomerge": false,
  "customManagers": [
    {
      "description": "Versions in workflows marked with a renovate comment (golangci-lint with: version, tool versions in env). Tags are kept as they are, so a v prefix stays.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Za-z0-9_-]+: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "Versions in Containerfile ARGs marked with a renovate comment (Go toolchain)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)images/.+/Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG .*?=(?<currentValue>.*)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "golangci-lint in the golangci-lint-action version input is handled by the CI tooling custom manager; skip the duplicate the github-actions manager finds",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "matchDepNames": [
        "golangci/golangci-lint"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go dependencies",
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Container base images",
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "groupName": "CI tooling"
    },
    {
      "description": "Automerge CI tooling (golangci-lint, ...) minor/patch once CI is green",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Automerge container base image updates (excludes the Go toolchain image)",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "!golang",
        "!docker.io/library/golang"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "automerge": true
    },
    {
      "description": "Automerge GitHub Actions minor/patch (majors stay manual)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Automerge Go module patch/digest updates (minor/major stay manual)",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Keep the Go toolchain (go.mod, Containerfile ARG and builder image) in one PR and merge it manually. Last, so the manager groups above do not override it.",
      "matchDepNames": [
        "go",
        "golang",
        "docker.io/library/golang"
      ],
      "groupName": "Go version",
      "automerge": false
    }
  ]
}
