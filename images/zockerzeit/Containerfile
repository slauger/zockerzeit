# renovate: datasource=golang-version depName=go
ARG GO_VERSION=1.27.4

FROM golang:${GO_VERSION} AS builder
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/zockerzeit ./cmd/zockerzeit

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.9-1795198179
LABEL org.opencontainers.image.source="https://github.com/slauger/zockerzeit" \
      org.opencontainers.image.description="Play time dashboard for parents based on the Nintendo Switch parental controls" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=builder /out/zockerzeit /usr/local/bin/zockerzeit
WORKDIR /data
USER 1001:0
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/zockerzeit"]
CMD ["-config", "/etc/zockerzeit/config.yaml"]
